{
  "name": "exetasy-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run ocr:assets && electron-vite dev",
    "build": "npm run ocr:assets && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "spike": "electron spike/main.mjs",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --dir",
    "test": "vitest run",
    "postinstall": "npm run build --workspaces --if-present",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@siwc/local": "*",
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/poppins": "^5.2.7",
    "@resvg/resvg-js": "^2.6.2",
    "@siwc/react": "*",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "material-symbols": "^0.48.2",
    "pdfjs-dist": "^4.10.38",
    "png-to-ico": "^3.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^6.1.2",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.9"
  },
  "description": "Free, local-first practice exams generated from your own course material.",
  "author": {
    "name": "Christian Ikirezi"
  },
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "vendor/siwc/*"
  ]
}
